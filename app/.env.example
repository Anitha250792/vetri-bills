# Copy to .env and edit. Restart `npx expo start` after changes.
#
# Web in the browser / iOS simulator:      http://127.0.0.1:8000
# Android emulator:                        http://10.0.2.2:8000
# Real phone on the same Wi-Fi as the PC:  http://<your PC's Wi-Fi IP>:8000
#   (start Django with: python manage.py runserver 0.0.0.0:8000)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
