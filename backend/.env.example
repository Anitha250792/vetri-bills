DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# SQLite is used unless POSTGRES_DB is set. To use PostgreSQL (docker compose up -d),
# remove the leading # from the five lines below.
# POSTGRES_DB=vetri_bills
# POSTGRES_USER=vetri
# POSTGRES_PASSWORD=vetri_pass
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

EXPIRY_WARNING_DAYS=7

# Payments. MOCK_PAYMENTS=1 never calls Razorpay (dummy keys are fine).
# For real Razorpay test mode: paste your rzp_test_ keys and set MOCK_PAYMENTS=0.
MOCK_PAYMENTS=1
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
